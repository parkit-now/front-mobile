{
  "name": "@parkit-now/front-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "front-mobile frontend (mobile)",
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform web",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "sync-types": "node scripts/sync-types.mjs",
    "sync-types:check": "node scripts/sync-types.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-web": "^0.19.13",
    "@expo/metro-runtime": "~4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^18.3.12",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
