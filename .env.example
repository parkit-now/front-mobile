# OpenAPI source for automatic API type generation
OPENAPI_URL="http://localhost:3000/api-json"

# Parkit backend base URL (REST). Change to GCP production URL to point there.
# Local (emulator/web):           http://localhost:3000
# Local (physical phone via LAN): http://192.168.1.50:3000
# Production:                     https://backend-148077191985.southamerica-east1.run.app
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Supabase (expo)
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# OAuth redirect (development build / release app)
# Keep this fixed for stable OAuth callback handling on mobile.
EXPO_PUBLIC_SUPABASE_OAUTH_REDIRECT_URL="parkit://auth/callback"



# If your phone cannot reach localhost services directly, use LAN IPs in your app config/services
# Example: http://192.168.1.50:3000
