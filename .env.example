# ================================================================
# PARKIT FRONT-MOBILE — environment variables
# ================================================================
# Manten dos archivos: .env.local (desarrollo) y .env.production
# (despliegue). Los Makefile copian el correcto a .env antes de
# correr: `make dev` -> .env.local, `make prod` -> .env.production.
# Ambos estan en .gitignore.
#
# Copia este template:
#   cp .env.example .env.local
#   cp .env.example .env.production
# y ajusta los valores en cada uno.
# ================================================================

# OpenAPI source for automatic API type generation (used by make sync-types)
OPENAPI_URL="http://localhost:3000/api-json"

# Parkit backend base URL (REST).
# Local (emulator/web):           http://localhost:3000
# Local (physical phone via LAN): http://192.168.1.50:3000
# Production:                     https://backend-148077191985.southamerica-east1.run.app
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Supabase project URL (base, sin /rest/v1/).
# Local:      http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase publishable / anon key (segura para clientes).
EXPO_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# OAuth redirect (development build / release app).
# Mantener fijo para callback OAuth estable en mobile.
EXPO_PUBLIC_SUPABASE_OAUTH_REDIRECT_URL="parkit://auth/callback"

# Google Maps SDK keys used only while generating native Android/iOS builds.
# Create separate restricted keys per platform. Expo Go does not require these
# values for local Android development.
GOOGLE_MAPS_ANDROID_API_KEY=""
GOOGLE_MAPS_IOS_API_KEY=""
